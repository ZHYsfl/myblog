": 101.6, "c": "的"}, {"t": 101.68, "end": 102.0, "c": "死"}, {"t": 102.16, "end": 102.4, "c": "心"}]}, {"t": 102.4, "end": 110.22, "text": "我有何德何能值得你珍惜", "chars": [{"t": 102.4, "end": 102.64, "c": "我"}, {"t": 102.64, "end": 102.94, "c": "有"}, {"t": 102.64, "end": 102.94, "c": "何"}, {"t": 102.64, "end": 102.94, "c": "德"}, {"t": 102.64, "end": 105.92, "c": "何"}, {"t": 105.92, "end": 109.04, "c": "能"}, {"t": 109.04, "end": 109.36, "c": "值"}, {"t": 109.36, "end": 109.5, "c": "得"}, {"t": 109.64, "end": 109.78, "c": "你"}, {"t": 109.92, "end": 110.22, "c": "珍"}, {"t": 109.92, "end": 110.22, "c": "惜"}]}, {"t": 109.92, "end": 116.48, "text": "为何你对我有求必应", "chars": [{"t": 109.92, "end": 110.46, "c": "为"}, {"t": 110.46, "end": 110.99, "c": "何"}, {"t": 111.53, "end": 112.07, "c": "你"}, {"t": 112.61, "end": 113.14, "c": "对"}, {"t": 113.68, "end": 114.24, "c": "我"}, {"t": 114.3, "end": 114.36, "c": "有"}, {"t": 114.42, "end": 114.48, "c": "求"}, {"t": 116.0, "end": 116.3, "c": "必"}, {"t": 116.0, "end": 116.48, "c": "应"}]}, {"t": 116.73, "end": 123.34, "text": "每次一想到你", "chars": [{"t": 116.73, "end": 116.98, "c": "每"}, {"t": 117.23, "end": 117.48, "c": "次"}, {"t": 117.74, "end": 117.99, "c": "一"}, {"t": 118.24, "end": 123.04, "c": "想"}, {"t": 123.04, "end": 123.34, "c": "到"}, {"t": 123.04, "end": 123.34, "c": "你"}]}, {"t": 123.04, "end": 123.87, "text": "像雨过天晴", "chars": [{"t": 123.04, "end": 123.36, "c": "像"}, {"t": 123.36, "end": 123.68, "c": "雨"}, {"t": 123.76, "end": 123.78, "c": "过"}, {"t": 123.81, "end": 123.83, "c": "天"}, {"t": 123.85, "end": 123.87, "c": "晴"}]}, {"t": 123.9, "end": 129.5, "text": "看见一只蝴蝶飞过废墟", "chars": [{"t": 123.9, "end": 123.92, "c": "看"}, {"t": 124.0, "end": 124.3, "c": "见"}, {"t": 124.0, "end": 124.88, "c": "一"}, {"t": 124.88, "end": 125.28, "c": "只"}, {"t": 126.32, "end": 126.48, "c": "蝴"}, {"t": 126.48, "end": 126.88, "c": "蝶"}, {"t": 126.88, "end": 127.24, "c": "飞"}, {"t": 127.6, "end": 127.96, "c": "过"}, {"t": 128.32, "end": 129.2, "c": "废"}, {"t": 129.