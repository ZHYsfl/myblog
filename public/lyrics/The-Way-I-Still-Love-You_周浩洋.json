 "going"}, {"t": 54.8, "end": 55.1, "c": "on"}, {"t": 54.8, "end": 55.1, "c": "with"}, {"t": 54.8, "end": 55.36, "c": "me"}]}, {"t": 55.36, "end": 58.7, "text": "But all I know it's haunting me", "chars": [{"t": 55.36, "end": 55.44, "c": "But"}, {"t": 55.44, "end": 55.74, "c": "all"}, {"t": 55.44, "end": 55.74, "c": "I"}, {"t": 55.44, "end": 57.28, "c": "know"}, {"t": 57.28, "end": 57.76, "c": "it's"}, {"t": 57.76, "end": 58.4, "c": "haunting"}, {"t": 58.4, "end": 58.7, "c": "me"}]}, {"t": 58.8, "end": 63.52, "text": "I need your love to set me free", "chars": [{"t": 58.8, "end": 61.44, "c": "I"}, {"t": 61.44, "end": 61.74, "c": "need"}, {"t": 61.44, "end": 61.68, "c": "your"}, {"t": 61.68, "end": 62.08, "c": "love"}, {"t": 62.08, "end": 62.32, "c": "to"}, {"t": 62.32, "end": 62.48, "c": "set"}, {"t": 62.72, "end": 63.04, "c": "me"}, {"t": 63.04, "end": 63.52, "c": "free"}]}, {"t": 63.52, "end": 66.22, "text": "Listen to me to me", "chars": [{"t": 63.52, "end": 63.84, "c": "Listen"}, {"t": 63.84, "end": 64.72, "c": "to"}, {"t": 64.72, "end": 65.92, "c": "me"}, {"t": 65.92, "end": 66.22, "c": "to"}, {"t": 65.92, "end": 66.22, "c": "me"}]}, {"t": 65.92, "end": 69.66, "text": "Do you still think about me baby", "chars": [{"t": 65.92, "end": 66.08, "c": "Do"}, {"t": 66.33, "end": 66.58, "c": "you"}, {"t": 66.83, "end": 67.08, "c": "still"}, {"t": 67.33, "end": 67.58, "c": "think"}, {"t": 67.83, "end": 68.08, "c": "about"}, {"t": 68.08, "end": 69.36, "c": "me"}, {"t": 69.36, "end": 69.66, "c": "baby"}]}, {"t": 70.08, "end": 70.38, "text": "Baby", "chars": [{"t": 70.08, "end": 70.38, "c": "Baby"}]}, {"t": 72.32, "end": 74.19, "text": "'Cause you're on my mind and", "chars": [{"t": 72.32, "end": 72.8, "c": "'Cause"}, {"t": 72.8, "end": 72.88, "c": "you're"}, {"t": 72.88, "end": 73.44, "c": "on"}, {"t": 73.44, "end": 73.52, "c": "my"}, {"t": 73.52, "end": 74.08, "c": "mind"}, {"t": 74.14, "end": 74.19, "c": "and"}]}, {"t": 74.25, "end": 76.3, "text": "It's driving me crazy 