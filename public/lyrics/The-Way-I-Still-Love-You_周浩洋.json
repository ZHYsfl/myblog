{"lines": [{"t": 0.0, "end": 24.64, "text": "Not a single day goes by", "chars": [{"t": 0.0, "end": 0.3, "c": "Not"}, {"t": 0.0, "end": 23.44, "c": "a"}, {"t": 23.44, "end": 23.76, "c": "single"}, {"t": 23.76, "end": 24.08, "c": "day"}, {"t": 24.08, "end": 24.48, "c": "goes"}, {"t": 24.48, "end": 24.64, "c": "by"}]}, {"t": 24.64, "end": 27.12, "text": "I know it's over but I can't deny", "chars": [{"t": 24.64, "end": 25.28, "c": "I"}, {"t": 25.28, "end": 25.44, "c": "know"}, {"t": 25.44, "end": 25.92, "c": "it's"}, {"t": 25.92, "end": 26.05, "c": "over"}, {"t": 26.19, "end": 26.32, "c": "but"}, {"t": 26.45, "end": 26.59, "c": "I"}, {"t": 26.72, "end": 26.85, "c": "can't"}, {"t": 26.99, "end": 27.12, "c": "deny"}]}, {"t": 28.16, "end": 32.22, "text": "I'm still missing you", "chars": [{"t": 28.16, "end": 28.56, "c": "I'm"}, {"t": 28.56, "end": 28.88, "c": "still"}, {"t": 31.28, "end": 31.92, "c": "missing"}, {"t": 31.92, "end": 32.22, "c": "you"}]}, {"t": 31.92, "end": 35.12, "text": "And I'm torn 'cause I'm hella frustrated", "chars": [{"t": 31.92, "end": 32.56, "c": "And"}, {"t": 32.56, "end": 34.08, "c": "I'm"}, {"t": 34.08, "end": 34.48, "c": "torn"}, {"t": 34.48, "end": 34.8, "c": "'cause"}, {"t": 34.8, "end": 35.04, "c": "I'm"}, {"t": 35.04, "end": 35.34, "c": "hella"}, {"t": 35.04, "end": 35.12, "c": "frustrated"}]}, {"t": 35.92, "end": 38.4, "text": "I know we had something special baby", "chars": [{"t": 35.92, "end": 36.08, "c": "I"}, {"t": 36.56, "end": 36.8, "c": "know"}, {"t": 36.8, "end": 37.1, "c": "we"}, {"t": 36.8, "end": 37.28, "c": "had"}, {"t": 37.28, "end": 37.44, "c": "something"}, {"t": 37.44, "end": 38.16, "c": "special"}, {"t": 38.16, "end": 38.4, "c": "baby"}]}, {"t": 39.2, "end": 41.76, "text": "But now the fact is you're gone for good", "chars": [{"t": 39.2, "end": 39.28, "c": "But"}, {"t": 39.28, "end": 39.44, "c": "now"}, {"t": 39.44, "end": 39.52, "c": "the"}, {"t": 39.52, "end": 40.0, "c": "fact"}, {"t": 40.0, "end": 40.24, "c": "is"}, 